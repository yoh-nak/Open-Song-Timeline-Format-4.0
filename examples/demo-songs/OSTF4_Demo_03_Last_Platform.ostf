  "soundSlots": [],
  "lyrics": {
    "documents": [
      {
        "id": "d03-lyric-main",
        "title": "Main Lyrics",
        "language": "en"
      }
    ],
    "phrases": [
      {
        "id": "d03-phrase-01",
        "documentId": "d03-lyric-main",
        "text": "Last train fading under the city rain I keep one light on by the empty line",
        "start": 5760,
        "duration": 17280
      },
      {
        "id": "d03-phrase-02",
        "documentId": "d03-lyric-main",
        "text": "Every window carries a memory through the glass",
        "start": 23040,
        "duration": 11520
      },
      {
        "id": "d03-phrase-03",
        "documentId": "d03-lyric-main",
        "text": "If tomorrow finds me standing where we were let the morning carry your name home",
        "start": 34560,
        "duration": 23040
      },
      {
        "id": "d03-phrase-04",
        "documentId": "d03-lyric-main",
        "text": "Rails grow quiet but the light remains",
        "start": 57600,
        "duration": 11520
      }
    ],
