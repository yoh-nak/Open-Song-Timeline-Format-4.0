  "lyrics": {
    "documents": [
      {
        "id": "d09-lyric-main",
        "title": "Main Lyrics",
        "language": "en"
      }
    ],
    "phrases": [
      {
        "id": "d09-phrase-01",
        "documentId": "d09-lyric-main",
        "text": "Open the window morning is waiting shadows are moving off the walls",
        "start": 15360,
        "duration": 30720
      },
      {
        "id": "d09-phrase-02",
        "documentId": "d09-lyric-main",
        "text": "I can hear the city waking softly",
        "start": 46080,
        "duration": 15360
      },
      {
        "id": "d09-phrase-03",
        "documentId": "d09-lyric-main",
        "text": "Two sides of morning meet in the light we carry both of them home",
        "start": 61440,
        "duration": 30720
      },
      {
        "id": "d09-phrase-04",
        "documentId": "d09-lyric-main",
        "text": "Every old reflection learns a new direction",
        "start": 92160,
        "duration": 15360
      },
      {
        "id": "d09-phrase-05",
        "documentId": "d09-lyric-main",
        "text": "Two sides of morning turn into one when we step out into the gold",
        "start": 107520,
        "duration": 30720
      }
    ],
