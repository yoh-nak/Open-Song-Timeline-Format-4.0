  "lyrics": {
    "documents": [
      {
        "id": "d12-lyric-main",
        "title": "Main Lyrics",
        "language": "en"
      }
    ],
    "phrases": [
      {
        "id": "d12-phrase-01",
        "documentId": "d12-lyric-main",
        "text": "Signal in the distance waking through the wire every quiet color starts to move",
        "start": 15360,
        "duration": 30720
      },
      {
        "id": "d12-phrase-02",
        "documentId": "d12-lyric-main",
        "text": "Hold the line a little longer",
        "start": 46080,
        "duration": 15360
      },
      {
        "id": "d12-phrase-03",
        "documentId": "d12-lyric-main",
        "text": "We are blooming in the noise turning static into light together",
        "start": 61440,
        "duration": 30720
      },
      {
        "id": "d12-phrase-04",
        "documentId": "d12-lyric-main",
        "text": "Underneath the bridge the old pulse changes",
        "start": 92160,
        "duration": 15360
      },
      {
        "id": "d12-phrase-05",
        "documentId": "d12-lyric-main",
        "text": "We are blooming in the noise every signal finds a shape and rises",
        "start": 107520,
        "duration": 30720
      },
      {
        "id": "d12-phrase-06",
        "documentId": "d12-lyric-main",
        "text": "Leave the final echo glowing",
        "start": 138240,
        "duration": 15360
      }
    ],
