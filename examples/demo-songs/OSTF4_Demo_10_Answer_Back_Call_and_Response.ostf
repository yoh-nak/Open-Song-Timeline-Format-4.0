    "phrases": [
      {
        "id": "d10-call-phrase-01",
        "documentId": "d10-lyric-call",
        "text": "Tell me where the fire went when the room went cold",
        "start": 15360,
        "duration": 30720
      },
      {
        "id": "d10-call-phrase-02",
        "documentId": "d10-lyric-call",
        "text": "Say it one more time and leave the door open",
        "start": 92160,
        "duration": 30720
      },
      {
        "id": "d10-resp-phrase-01",
        "documentId": "d10-lyric-response",
        "text": "It never left the room we only turned away",
        "start": 46080,
        "duration": 30720
      },
      {
        "id": "d10-resp-phrase-02",
        "documentId": "d10-lyric-response",
        "text": "I hear you now the answer comes back clear",
        "start": 92160,
        "duration": 30720
      }
    ],
